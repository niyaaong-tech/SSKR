# Existing preview remains mock until the isolated SSKR project is configured.
SSKR_BACKEND_MODE=mock
SSKR_APP_ORIGIN=http://127.0.0.1:8112
SSKR_DEV_PORT=8112
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only: workflow transactions and private photo storage. Never send to clients.
SUPABASE_SECRET_KEY=
# Matching Toss Payments widget keys. Leave blank until PG test setup is ready.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# A random 32-byte base64 secret. Never reuse the Supabase service role key.
SSKR_SESSION_SECRET=
# Supabase CLI Google provider configuration only; never expose in browser code.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Test website: confirm participation without PG charges or refunds.
SSKR_PARTICIPATION_MODE=test
